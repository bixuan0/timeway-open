# ============================================================
# 水电站施工区门禁场景 · 全中文版（.tw v2）
# 时途场景语言 TimeWay DSL —— 中国人自研，中英双语法
# ============================================================

场景 水电站门禁 {
  种子 42

  地图 {
    # ---- 节点：坐标定位置，朝向定出口方向 ----
    节点 营地 (0, 0) 朝向 90
    节点 坝区 (500, 300) 朝向 135
    节点 骨料场 (200, -200) 朝向 0
    节点 渣场 (-300, 200) 朝向 270

    # ---- 道路：车道/限速/弯道/坡度/路面 ----
    道路 营地->坝区 车道 2 限速 40 弯道 30 坡度 5% 路面 碎石
    道路 坝区->骨料场 车道 1 限速 25 坡度 8% 路面 碎石
    道路 骨料场->渣场 车道 2 限速 35 坡度 3% 路面 泥结
    道路 渣场->营地 车道 2 限速 40 路面 碎石

    # ---- 区域：卡口强制减速 + 装卸区排队 ----
    区域 卡口 { 限速区 位于 营地->坝区 1.2公里 降到 10 }
    区域 装卸 { 装卸区 位于 坝区->骨料场 2.0公里 容量 4 }
  }

  # ---- 天气剧本：显式时间线（出现/消失/交替）----
  # v3 新增「转移」语句：精确控制转换时刻与目标天气（
  #   转移 <时刻> 转向 <天气>   —— 对应引擎 weather_transition
  # 引擎目前只消费首条显式转移；多条转移为语言层预留（IR 完整记录），
  # 不写转移时，第 2 个剧本段起点仍按隐式转换处理，保持向后兼容）
  天气 {
    剧本  0-600秒 晴
    剧本  600-1800秒 大雨
    转移 618 转向 大雨
    剧本  1800-2400秒 雾
    剧本  2400-3600秒 晴
  }

  车辆 {
    # v5 P0：超载自卸卡车（载重 1.2 > 1.0 → overload 标记，侧翻/上坡风险核心场景）
    20辆 自卸卡车 { 质量 24吨 最大总质量 55吨 载重 1.2 风阻CdA 4.5 滚动阻力 0.012 制动效率 0.8 质心高度 2.0 最大功率 320 }
    5辆 水泥罐车 { 质量 20吨 最大总质量 35吨 载重 1.0 质心高度 1.9 最大功率 280 }
    5辆 通勤班车 { 质量 10吨 质心高度 1.5 }
  }

  规则 {
    # ---- ③ 施工事件（对齐 MVP：爆破封路 / 落石占道 / 人员横穿）----
    # 爆破封路：600s 全车道禁行 30 分钟
    当 时间(600) 封路(营地->坝区, 1800)
    # 落石占道：坝区->骨料场 单车道堵塞（随机 30%）
    当 随机(0.3) 事故(坝区->骨料场, 1)
    # 泥结便道塌陷：骨料场->渣场 单车道堵塞（随机 20%）
    当 随机(0.2) 事故(骨料场->渣场, 1)
    # 回程便桥管制：渣场->营地 定时封路 20 分钟（错峰放行）
    当 时间(900) 封路(渣场->营地, 1200)
    # 翻斗车倾倒占道：渣场->营地 单车道（定时 1200s）
    当 时间(1200) 事故(渣场->营地, 1)
    # 人员横穿（near-miss 高发点：卡口 / 装卸区视线遮挡处）
    当 横穿 人员(卡口)
    当 横穿 人员(装卸)
  }
}
