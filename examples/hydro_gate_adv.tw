# ============================================================
# 水电站施工区门禁场景 · 进阶版（.tw 进阶语法示范）
# 展示：变量 / 表达式 / 天气联动 / 全中文
# 注意：变量名用英文字母（base_speed），因中文变量名若含
#       关键字（如"限速"）会被归一化拆分。
# ============================================================

场景 水电站门禁进阶 {
  种子 42

  # ---- 变量：一次定义，处处引用 ----
  设 base_speed = 40
  设 rain_factor = 0.6

  地图 {
    节点 营地 (0, 0) 朝向 90
    节点 坝区 (500, 300) 朝向 135
    节点 骨料场 (200, -200) 朝向 0
    节点 渣场 (-300, 200) 朝向 270

    # ---- 表达式：限速随变量算，改一处全改 ----
    道路 营地->坝区 车道 2 限速 base_speed 弯道 30 坡度 5% 路面 碎石
    道路 坝区->骨料场 车道 1 限速 base_speed*0.6 坡度 8% 路面 碎石
    道路 骨料场->渣场 车道 2 限速 base_speed-5 坡度 3% 路面 泥结
    道路 渣场->营地 车道 2 限速 base_speed 路面 碎石

    区域 卡口 { 限速区 位于 营地->坝区 1.2公里 降到 10 }
    区域 装卸 { 装卸区 位于 坝区->骨料场 2.0公里 容量 4 }
  }

  天气 {
    剧本 0-600秒 晴
          600-1800秒 暴雨
          1800-2400秒 团雾
          2400-3600秒 晴
  }

  车辆 {
    20辆 自卸卡车
    5辆 水泥罐车
    5辆 通勤班车
  }

  规则 {
    # 爆破封路
    当 时间(600) 封路(营地->坝区, 1800)
    # 落石占道
    当 随机(0.3) 事故(坝区->骨料场, 1)
    # 人员横穿
    当 横穿 人员(卡口)
    # 天气联动：暴雨时营地->坝区限速自动降到 base_speed*rain_factor
    当 天气=暴雨 道路 营地->坝区 限速 降到 base_speed*rain_factor
  }
}
